{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "og-svg",
  "main": "src/index.js",
  "compatibility_date": "2026-07-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "rules": [
    { "type": "Data", "globs": ["**/*.ttf"], "fallthrough": true }
  ]
}
